%[text] EMS LAB 1
clear;
clc;
close all;
%[text] 1\. NTC PARAMETERS
R0   = 10000;
beta = 3380;
T0   = 25;

Tmin = 20;
Tmax = 50;

Vdd = 3.3;
%[text] 2\. TEMPERATURE
T0K = T0 + 273.15;

T = Tmin:0.1:Tmax;      % Temperature vector, step = 0.1 °C
TK = T + 273.15;
%[text] 3\. NTC MODEL
Rntc = R0 .* exp(beta .* (1./TK - 1/T0K));

% For an NTC:
% Tmin -> maximum resistance
% Tmax -> minimum resistance
Rmax = Rntc(1);         % First value corresponds to Tmin
Rmin = Rntc(end);       % Last value corresponds to Tmax
%[text] 4\. DIMENSION R1
%R1 = sqrt(Rmax * Rmin);

R1 = 10000;

fprintf('R1 ideal = %.2f kOhm\n', R1/1000); %[output:0a7c4a29]
%[text] 5\. VOLTAGE DIVIDER
%
%       Vdd
%        |
%       NTC
%        |
%        +------ Vin
%        |
%        R1
%        |
%       GND

Vin = Vdd .* R1 ./ (Rntc + R1);


fprintf('\n--- Vin ---\n'); %[output:6b8982f3]
fprintf('Vin min = %.3f V\n', min(Vin)); %[output:86da86ab]
fprintf('Vin max = %.3f V\n', max(Vin)); %[output:0a9e68c0]
%[text] 6\. CURRENT
I = Vdd ./ (R1 + Rntc);


fprintf('\n--- Current ---\n'); %[output:0b32debb]
fprintf('I max = %.3f mA\n', max(I)*1000); %[output:1bf199ca]
%[text] 7\. NTC POWER
Pntc = I.^2 .* Rntc;


fprintf('\n--- NTC Power ---\n'); %[output:72ddee65]
fprintf('P max = %.3f mW\n', max(Pntc)*1000); %[output:7bc7c4ab]
%[text] 8\. GRAPHS
figure; %[output:640ccfb9]

plot(T,Rntc/1000,'LineWidth',2); %[output:640ccfb9]

grid on; %[output:640ccfb9]

xlabel('Temperature [°C]'); %[output:640ccfb9]
ylabel('NTC Resistance [k\Omega]'); %[output:640ccfb9]
title('NTC Resistance vs Temperature'); %[output:640ccfb9]
figure; %[output:14e17509]

plot(T,Vin,'LineWidth',2); %[output:14e17509]

grid on; %[output:14e17509]

xlabel('Temperature [°C]'); %[output:14e17509]
ylabel('Vin [V]'); %[output:14e17509]
title('Voltage Divider Output vs Temperature'); %[output:14e17509]


figure; %[output:29fa6485]

plot(T,I*1000,'LineWidth',2); %[output:29fa6485]

grid on; %[output:29fa6485]

xlabel('Temperature [°C]'); %[output:29fa6485]
ylabel('Current [mA]'); %[output:29fa6485]
title('NTC Current vs Temperature'); %[output:29fa6485]
%%
%[text] ## Soil Sensor
%%
Rfixa = (5*10 ^3 : 10 : 100 * 10 ^3);

Rmax = 200 * 10^6;
Rmin = 6 * 10 ^3 ;

voutdry  = 3.3 .* (Rmax ./ (Rmax + Rfixa));
voutwet  = 3.3 .* (Rmin ./ (Rmin + Rfixa));
plot (Rfixa, voutwet); %[output:34abd900]

ax = gca;
chart = ax.Children(1);
datatip(chart,2.218e+04,0.7026); %[output:34abd900]
plot (Rfixa, voutdry); %[output:042dd34a]
adcM= 3.3*4095 / 3.3 %[output:5afb3544]
adcm = 0.7026 * 4095 / 3.3 %[output:386df977]

